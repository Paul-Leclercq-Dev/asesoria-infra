# Copier en .env (ignoré par Git) et remplir depuis le gestionnaire de mots de passe.
# Charger avec :  set -a; . ./.env; set +a
# State (sorties de bootstrap/)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Jeton d'API OVH (le même que bootstrap/, limité à /cloud/project/<id>/*)
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
