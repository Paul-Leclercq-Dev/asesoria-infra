# Copier en .env (ignoré par Git) et remplir depuis le gestionnaire de mots de passe.
# Charger avec :  set -a; . ./.env; set +a
# State (sorties de bootstrap/)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Jeton d'API OVH NEUF (même URL que docs/bootstrap.fr.md §1, validité 1 jour : le jeton du
# bootstrap a expiré). Erreur « This call has not been granted » = jeton expiré ou autre projet.
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
