# Copier en .env (ignoré par Git). Charger avec :  set -a; . ./.env; set +a
# Jeton d'API OVH limité à /cloud/project/<id>/* (voir docs/bootstrap.fr.md)
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
# Après la migration du state dans le bucket (étape 2) : sorties state_* de ce bootstrap
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
